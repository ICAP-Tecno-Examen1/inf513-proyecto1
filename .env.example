# Copiar como .env y completar. El archivo .env NO se sube al repositorio.


# Pago Fácil
PAGOFACIL_TOKEN_SERVICE=
PAGOFACIL_TOKEN_SECRET=
PAGOFACIL_CALLBACK_URL=https://tu-dominio.ngrok-free.app/webhook/pagofacil

# true: no llama a Pago Fácil; genera un QR de prueba y el pago se confirma abriendo
# http://localhost:8080/webhook/simular?pago={id_pago}. Pon false para usar Pago Fácil real.
PAGOFACIL_SIMULADO=false
